# MREF/TRIRIGA Configuration
# Copy this file to .env and fill in your credentials

# MREF Server URL (for proxy configuration in development)
VITE_MREF_URL=https://semas.facilities.semas.apps.srvengmas.cp.fyre.ibm.com

# MREF Server Base URL (legacy, kept for compatibility)
VITE_MREF_BASE_URL=https://semas.facilities.semas.apps.srvengmas.cp.fyre.ibm.com

# MREF Credentials (optional - can be entered in UI)
VITE_MREF_USERNAME=your_username_here
VITE_MREF_PASSWORD=your_password_here

# Development Settings
VITE_USE_MOCK_DATA=false

# Notes:
# - In development, the app uses a proxy to avoid CORS issues
# - Update VITE_MREF_URL to match your MREF instance
# - Restart dev server after changing VITE_MREF_URL
# - VPN connection may be required to access MREF server
# - Never commit .env file to version control
# - Keep credentials secure